# Local writing only: loaded by the server, never included in frontend assets.
OPENROUTER_API_KEY=
GROQ_API_KEY=
SYMWRITE_MODE=local
# Optional private profile; keep it under ignored profiles/ or private-data/.
# SYMWRITE_CONFIG=/absolute/path/to/profiles/my-notebook.yaml
# SYMWRITE_RETRIEVAL=lexical

# Public beta: configure in the hosting platform's secret store, not source control.
# Read docs/PUBLIC_BETA.md before changing the mode. All prerequisites are mandatory.
# SYMWRITE_MODE=public
# SYMWRITE_ORIGIN=https://write.example.com
# SYMWRITE_SESSION_SECRET=  # random secret, at least 32 characters
# SYMWRITE_GOOGLE_CLIENT_ID=
# SYMWRITE_GOOGLE_CLIENT_SECRET=
# SYMWRITE_TURNSTILE_SITE_KEY=
# SYMWRITE_TURNSTILE_SECRET=
# SYMWRITE_OPENROUTER_API_KEY=  # a SEPARATE app key with a finite credit limit
# SYMWRITE_MAX_KEY_LIMIT_USD=10
# SYMWRITE_DAILY_LIMIT=10
# SYMWRITE_GLOBAL_DAILY_LIMIT=100
# SYMWRITE_NETWORK_DAILY_LIMIT=30
# SYMWRITE_PER_MINUTE=3
# SYMWRITE_ACCESS_DB=/data/symwrite/access.sqlite3  # persistent single-host volume
# SYMWRITE_TRUSTED_PROXIES=  # exact proxy IPs/CIDRs, never 0.0.0.0/0 or ::/0
